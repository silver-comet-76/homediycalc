---
import Layout from "../components/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const crumbs = [{ name: "Home", path: "/" }, { name: "Page not found" }];
---

<Layout
  title="Page not found"
  description="The page you were looking for does not exist on HomeDIYCalc. Go back to the home page or browse all calculators."
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
    Page not found
  </h1>
  <p class="mt-3 max-w-3xl text-lg text-slate-600">
    Sorry — the page you were looking for does not exist or was moved. It may
    have been a mistyped address, or a link to a calculator that has not been
    built yet.
  </p>
  <p class="mt-6 flex flex-wrap gap-3">
    <a href="/" class="btn-primary">Go to the home page</a>
    <a href="/calculators/" class="btn-secondary">Browse all calculators</a>
  </p>
</Layout>
