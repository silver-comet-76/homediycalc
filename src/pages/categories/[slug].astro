---
import Layout from "../../components/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { CATEGORIES, getCalculatorsByCategory } from "../../lib/registry";
import { SHIPPED_CALCULATOR_SLUGS } from "../../calculators/index";
import type { CategorySlug } from "../../lib/registry";

const shipped = new Set(SHIPPED_CALCULATOR_SLUGS);

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const category = CATEGORIES.find((cat) => cat.slug === slug);
if (!category) {
  throw new Error(`Unknown category slug: ${slug}`);
}
const calculators = getCalculatorsByCategory(category.slug as CategorySlug);
const otherCategories = CATEGORIES.filter((cat) => cat.slug !== category.slug);
const crumbs = [
  { name: "Home", path: "/" },
  { name: "All Calculators", path: "/calculators/" },
  { name: category.name },
];
---

<Layout
  title={category.name}
  description={category.seoDescription}
  canonical={category.url}
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
    {category.name} Calculators
  </h1>
  <p class="mt-3 max-w-3xl text-lg text-slate-600">{category.description}</p>
  <p class="mt-2 max-w-3xl text-slate-600">
    {calculators.length} calculator{calculators.length === 1 ? "" : "s"} in this category.
    Entries below are linked only when built and tested.
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      calculators.map((calc) => (
        <li class="card">
          {shipped.has(calc.slug) ? (
            <a href={calc.url} class="font-semibold text-slate-900">
              {calc.name}
            </a>
          ) : (
            <p class="font-semibold text-slate-900">{calc.name}</p>
          )}
          <p class="mt-1 text-sm text-slate-600">{calc.summary}</p>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
            {shipped.has(calc.slug)
              ? `${calc.priority} · Available now`
              : `${calc.priority} · Arrives in Phase ${calc.phase}`}
          </p>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="other-categories" class="mt-12">
    <h2 id="other-categories" class="text-2xl font-bold text-slate-900">
      Other categories
    </h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        otherCategories.map((cat) => (
          <li>
            <a href={cat.url} class="btn-secondary px-3 py-1.5 text-sm">
              {cat.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
