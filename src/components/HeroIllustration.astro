---
/**
 * Hero illustration — homepage only (prototype V2).
 *
 * A custom, locally bundled, flat-style SVG scene of recognizable
 * DIY materials and tools: a wall with a freshly painted band and a
 * paint roller, a spirit level, an open paint can, an unrolled
 * measuring tape, a trowel, and a small tile grid. No external image,
 * no CDN, no paid asset, no runtime fetch — the SVG is inline, so it
 * adds no HTTP request and scales cleanly at any size.
 *
 * Decorative only (aria-hidden): the page's real content is the hero
 * copy and the Paint demo numbers. Nothing in the drawing states a
 * measurement or a fact — it is a visual motif, not a diagram.
 */
---

<div aria-hidden="true" class="relative">
  <svg
    viewBox="0 0 480 360"
    class="h-auto w-full"
    role="presentation"
    focusable="false"
  >
    {/* Warm backdrop blobs */}
    <circle cx="240" cy="185" r="168" fill="#ffedd5" />
    <circle cx="392" cy="62" r="58" fill="#fed7aa" />
    <circle cx="78" cy="312" r="44" fill="#fed7aa" />

    {/* Wall */}
    <rect
      x="70"
      y="50"
      width="340"
      height="212"
      rx="14"
      fill="#ffffff"
      stroke="#e2e8f0"
      stroke-width="2"
    />
    {/* Freshly painted band */}
    <rect x="70" y="140" width="340" height="52" fill="#ea580c" />
    {/* Wet-paint drips under the band */}
    <path d="M 128 192 q 0 14 -6 14 q -6 0 -6 -14 z" fill="#ea580c" />
    <path d="M 300 192 q 0 10 -4.5 10 q -4.5 0 -4.5 -10 z" fill="#ea580c" />

    {/* Spirit level on the wall */}
    <g>
      <rect x="100" y="84" width="118" height="20" rx="10" fill="#facc15" stroke="#eab308" stroke-width="1.5" />
      <rect x="148" y="89" width="22" height="10" rx="5" fill="#fefce8" stroke="#a16207" stroke-width="1" />
      <circle cx="159" cy="94" r="3" fill="#22c55e" />
      <line x1="112" y1="89" x2="112" y2="99" stroke="#a16207" stroke-width="1.5" />
      <line x1="206" y1="89" x2="206" y2="99" stroke="#a16207" stroke-width="1.5" />
    </g>

    {/* Paint roller on the band */}
    <g transform="rotate(18 335 160)">
      <rect x="292" y="148" width="72" height="24" rx="10" fill="#f97316" stroke="#c2410c" stroke-width="2" />
      <rect x="300" y="154" width="56" height="12" rx="6" fill="#fdba74" opacity="0.7" />
      <path d="M 364 160 h 18 v 34" fill="none" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
      <rect x="376" y="194" width="12" height="44" rx="6" fill="#334155" />
    </g>

    {/* Tile grid, floating top-right */}
    <g transform="rotate(-10 428 44)">
      <rect x="398" y="14" width="64" height="64" rx="8" fill="#cbd5e1" opacity="0.55" />
      <rect x="392" y="8" width="28" height="28" rx="4" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5" />
      <rect x="424" y="8" width="28" height="28" rx="4" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5" />
      <rect x="392" y="40" width="28" height="28" rx="4" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5" />
      <rect x="424" y="40" width="28" height="28" rx="4" fill="#fff7ed" stroke="#94a3b8" stroke-width="1.5" />
    </g>

    {/* Open paint can, bottom-left */}
    <g>
      <rect x="84" y="254" width="106" height="86" rx="10" fill="#ea580c" stroke="#c2410c" stroke-width="2" />
      <rect x="84" y="254" width="106" height="14" rx="7" fill="#c2410c" />
      <ellipse cx="137" cy="261" rx="42" ry="5" fill="#fdba74" />
      <rect x="104" y="288" width="66" height="30" rx="4" fill="#ffffff" />
      <path d="M 137 294 q 7 9 0 13 q -7 -4 0 -13 z" fill="#ea580c" />
      <path d="M 190 268 q 0 12 -5 12 q -5 0 -5 -12 z" fill="#f97316" />
    </g>

    {/* Measuring tape, unrolled along the bottom */}
    <g>
      <rect x="212" y="296" width="48" height="48" rx="10" fill="#eab308" stroke="#a16207" stroke-width="1.5" />
      <circle cx="236" cy="320" r="11" fill="#fefce8" stroke="#a16207" stroke-width="1.5" />
      <circle cx="236" cy="320" r="3.5" fill="#a16207" />
      <rect x="260" y="312" width="158" height="18" fill="#facc15" stroke="#eab308" stroke-width="1.5" />
      <g stroke="#0f172a" stroke-width="1.5">
        <line x1="276" y1="312" x2="276" y2="321" />
        <line x1="292" y1="312" x2="292" y2="318" />
        <line x1="308" y1="312" x2="308" y2="321" />
        <line x1="324" y1="312" x2="324" y2="318" />
        <line x1="340" y1="312" x2="340" y2="321" />
        <line x1="356" y1="312" x2="356" y2="318" />
        <line x1="372" y1="312" x2="372" y2="321" />
        <line x1="388" y1="312" x2="388" y2="318" />
        <line x1="404" y1="312" x2="404" y2="321" />
      </g>
      <rect x="418" y="309" width="8" height="24" rx="2" fill="#94a3b8" stroke="#64748b" stroke-width="1" />
    </g>

    {/* Trowel, leaning bottom-right */}
    <g transform="rotate(-24 402 268)">
      <rect x="382" y="252" width="62" height="15" rx="4" fill="#cbd5e1" stroke="#64748b" stroke-width="1.5" />
      <rect x="408" y="267" width="10" height="34" rx="5" fill="#78350f" />
      <rect x="404" y="267" width="18" height="8" rx="3" fill="#92400e" />
    </g>
  </svg>
</div>
