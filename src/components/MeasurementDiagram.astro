---
/**
 * Shared SVG measurement diagram — one component for every
 * calculator page (Phase 4). Each variant is a simple, accurate
 * line drawing of what to measure: a room or area, a slab with
 * depth, a wall, a ceiling grid, a sealant bead cross-section,
 * a room perimeter, or a board. No diagram invents a measurement
 * the calculator does not use.
 */
import type { DiagramKind } from "../components/react/CalculatorConfig";

export interface Props {
  kind: DiagramKind;
}

const { kind } = Astro.props;

const labels: Record<DiagramKind, string> = {
  area: "Rectangle showing length across the bottom and width up the side",
  volume: "Slab showing length, width, and depth",
  wall: "Wall showing width across the bottom, height up the side, and a door opening",
  ceiling: "Ceiling grid showing 2 ft by 2 ft tiles between main beams",
  joint: "Cross-section of a joint showing bead width and bead depth",
  linear: "Room outline showing the perimeter measured at floor level",
  board: "Board showing length, width, and thickness",
  stair: "Stair profile diagram: vertical rise up the side, horizontal run along the bottom, and the stringer diagonal",
};
---

<figure class="mt-6 max-w-xl" aria-label={labels[kind]}>
  <svg viewBox="0 0 360 200" class="h-auto w-full rounded-lg border border-slate-200 bg-white" aria-hidden="true">
    <defs>
      <marker id="arr" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" fill="#334155" />
      </marker>
    </defs>
    {
      kind === "area" && (
        <>
          <rect x="70" y="30" width="220" height="120" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <line x1="70" y1="170" x2="290" y2="170" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="180" y="188" text-anchor="middle" font-size="13" fill="#334155">Length</text>
          <line x1="310" y1="30" x2="310" y2="150" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="330" y="95" text-anchor="middle" font-size="13" fill="#334155" transform="rotate(90 330 95)">Width</text>
          <text x="180" y="95" text-anchor="middle" font-size="13" fill="#475569">Area = Length × Width</text>
        </>
      )
    }
    {
      kind === "volume" && (
        <>
          <polygon points="70,90 250,90 280,60 100,60" fill="#cbd5e1" stroke="#334155" stroke-width="2" />
          <polygon points="250,90 280,60 280,140 250,170" fill="#94a3b8" stroke="#334155" stroke-width="2" />
          <rect x="70" y="90" width="180" height="80" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <line x1="70" y1="190" x2="250" y2="190" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="160" y="188" text-anchor="middle" font-size="12" fill="#334155">Length</text>
          <line x1="300" y1="60" x2="300" y2="140" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="318" y="105" text-anchor="middle" font-size="12" fill="#334155" transform="rotate(90 318 105)">Depth</text>
          <text x="160" y="135" text-anchor="middle" font-size="13" fill="#475569">Volume = L × W × Depth</text>
        </>
      )
    }
    {
      kind === "wall" && (
        <>
          <rect x="60" y="25" width="240" height="130" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <rect x="130" y="85" width="50" height="70" fill="#ffffff" stroke="#334155" stroke-width="1.5" />
          <text x="155" y="130" text-anchor="middle" font-size="11" fill="#475569">Door</text>
          <line x1="60" y1="175" x2="300" y2="175" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="180" y="193" text-anchor="middle" font-size="13" fill="#334155">Width</text>
          <line x1="320" y1="25" x2="320" y2="155" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="340" y="95" text-anchor="middle" font-size="13" fill="#334155" transform="rotate(90 340 95)">Height</text>
          <text x="245" y="70" text-anchor="middle" font-size="12" fill="#475569">Wall area</text>
        </>
      )
    }
    {
      kind === "ceiling" && (
        <>
          <rect x="60" y="25" width="240" height="130" fill="#ffffff" stroke="#334155" stroke-width="2" />
          <line x1="120" y1="25" x2="120" y2="155" stroke="#334155" stroke-width="1" />
          <line x1="180" y1="25" x2="180" y2="155" stroke="#334155" stroke-width="1" />
          <line x1="240" y1="25" x2="240" y2="155" stroke="#334155" stroke-width="1" />
          <line x1="60" y1="68" x2="300" y2="68" stroke="#334155" stroke-width="1" />
          <line x1="60" y1="112" x2="300" y2="112" stroke="#334155" stroke-width="1" />
          <line x1="60" y1="25" x2="60" y2="155" stroke="#0f766e" stroke-width="4" />
          <line x1="180" y1="25" x2="180" y2="155" stroke="#0f766e" stroke-width="4" />
          <line x1="300" y1="25" x2="300" y2="155" stroke="#0f766e" stroke-width="4" />
          <text x="180" y="180" text-anchor="middle" font-size="13" fill="#334155">Main beams (teal) 4 ft apart — tiles sit between them</text>
          <text x="90" y="52" text-anchor="middle" font-size="11" fill="#475569">2 ft</text>
          <text x="150" y="52" text-anchor="middle" font-size="11" fill="#475569">2 ft</text>
        </>
      )
    }
    {
      kind === "joint" && (
        <>
          <rect x="60" y="60" width="110" height="90" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <rect x="190" y="60" width="110" height="90" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <rect x="170" y="60" width="20" height="90" fill="#0f766e" stroke="#334155" stroke-width="1.5" />
          <line x1="170" y1="45" x2="190" y2="45" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="180" y="32" text-anchor="middle" font-size="13" fill="#334155">Width</text>
          <line x1="320" y1="60" x2="320" y2="150" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="340" y="110" text-anchor="middle" font-size="13" fill="#334155" transform="rotate(90 340 110)">Depth</text>
          <text x="180" y="180" text-anchor="middle" font-size="13" fill="#334155">Sealant fills the joint — width × depth is the bead</text>
        </>
      )
    }
    {
      kind === "linear" && (
        <>
          <rect x="70" y="35" width="220" height="120" fill="none" stroke="#334155" stroke-width="3" />
          <line x1="150" y1="155" x2="210" y2="155" stroke="#ffffff" stroke-width="5" />
          <text x="180" y="148" text-anchor="middle" font-size="11" fill="#475569">Door (no baseboard)</text>
          <line x1="70" y1="20" x2="290" y2="20" stroke="#0f766e" stroke-width="2" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="180" y="14" text-anchor="middle" font-size="11" fill="#0f766e">Measure around — perimeter minus doors</text>
          <text x="180" y="95" text-anchor="middle" font-size="13" fill="#475569">Measure at floor level</text>
        </>
      )
    }
    {
      kind === "board" && (
        <>
          <rect x="40" y="70" width="280" height="44" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
          <line x1="40" y1="140" x2="320" y2="140" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="180" y="158" text-anchor="middle" font-size="13" fill="#334155">Length (ft)</text>
          <line x1="335" y1="70" x2="335" y2="114" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="348" y="97" text-anchor="middle" font-size="11" fill="#334155" transform="rotate(90 348 97)">Width</text>
          <text x="180" y="97" text-anchor="middle" font-size="13" fill="#475569">Thickness × Width × Length</text>
          <text x="180" y="180" text-anchor="middle" font-size="12" fill="#475569">Board feet = thickness (in) × width (in) × length (ft) ÷ 12</text>
        </>
      )
    }
    {
      kind === "stair" && (
        <>
          {/*
            QA-17B1-UI-03 (corrected geometry): 4 risers, 3 treads —
            Treads = Risers − 1, Total Run = Treads × Tread Depth.
            The upper finished floor is a separate level at the top
            (x 240–330, y 40), NOT a tread, and the Total Run dimension
            spans only the 3 tread intervals (x 60–240). The stringer
            diagonal runs from the base of the first riser (60,160) to
            the top of the last riser (240,40) — the same rise/run the
            dimensions measure. The figure's aria-label deliberately
            avoids the input labels "total rise", "tread depth" and
            "maximum riser height" (see STAGE1_PLAN.md §5).
          */}
          <polygon
            points="60,160 60,130 120,130 120,100 180,100 180,70 240,70 240,40 240,160"
            fill="#e2e8f0"
            stroke="#334155"
            stroke-width="2"
          />
          <line x1="30" y1="160" x2="60" y2="160" stroke="#334155" stroke-width="3" />
          <text x="45" y="174" text-anchor="middle" font-size="11" fill="#334155">
            Lower floor
          </text>
          <line x1="240" y1="40" x2="330" y2="40" stroke="#334155" stroke-width="3" />
          <text x="310" y="30" text-anchor="middle" font-size="11" fill="#334155">
            Upper floor
          </text>
          <line
            x1="60"
            y1="160"
            x2="240"
            y2="40"
            stroke="#334155"
            stroke-width="1.5"
            stroke-dasharray="5 4"
          />
          <line x1="40" y1="40" x2="40" y2="160" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="26" y="100" text-anchor="middle" font-size="12" fill="#334155" transform="rotate(-90 26 100)">Total rise</text>
          <line x1="60" y1="178" x2="240" y2="178" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="150" y="194" text-anchor="middle" font-size="12" fill="#334155">Total run</text>
          <line x1="60" y1="122" x2="120" y2="122" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="90" y="112" text-anchor="middle" font-size="11" fill="#334155">Tread depth</text>
          <line x1="255" y1="40" x2="255" y2="70" stroke="#334155" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)" />
          <text x="262" y="59" font-size="11" fill="#334155">Riser height</text>
          <text x="180" y="150" text-anchor="middle" font-size="12" fill="#475569">Stringer = √(rise² + run²)</text>
        </>
      )
    }
  </svg>
  <figcaption class="mt-2 text-sm text-slate-500">
    {
      kind === "area" && "Measure the length and width of the area in feet."
    }
    {
      kind === "volume" && "Measure length, width, and depth in feet — depth is usually in inches, so convert it."
    }
    {
      kind === "wall" && "Measure each wall's width and height, then subtract doors and windows."
    }
    {
      kind === "ceiling" && "Main beams run 4 ft apart; 2 ft cross tees split the grid for 2 × 2 ft tiles."
    }
    {
      kind === "joint" && "Measure the joint length, then the bead width and depth in inches."
    }
    {
      kind === "linear" && "Measure every wall at floor level and subtract the door openings."
    }
    {
      kind === "board" && "Measure thickness and width in inches, length in feet — nominal sizes for softwood."
    }
    {
      kind === "stair" &&
      "Measurement schematic — not a cut-ready or structural construction drawing. Measure the total rise floor to floor, then the tread depth; the stringer is the diagonal under the steps."
    }
  </figcaption>
</figure>
